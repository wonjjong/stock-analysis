# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/outputs/
/work/
*.tsbuildinfo
/data/

# Python / Django
__pycache__/
*.py[cod]
.venv/
venv/
*.sqlite3
db.sqlite3
local_settings.py
.mypy_cache/
.pytest_cache/
.ruff_cache/
staticfiles/
media/

# DB 덤프 — llm_providers 에 API 키가 들어 있다
*.dump
*.sql.gz

# 동일성 검증용으로 내려받은 실제 언론사 페이지 원문. 전문을 저장소에 두지 않는다
# (README 데이터 수집 원칙과 같은 이유). 재생성:
#   node scripts/harvest-parity.mjs --live
/tests/parity/pages/

# Python 패키지 빌드 산출물
*.egg-info/

# JetBrains IDE 설정. 개발자마다 다르므로 추적하지 않는다.
.idea/
