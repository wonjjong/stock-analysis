SIGNALIST_OPENAI_API_KEY=
SIGNALIST_OPENAI_NEWS_MODEL=gpt-5.6-terra
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/signalist

# 본문 분석용 LLM. 보통은 /news/providers 화면에서 DB에 등록하고, 아래 값은
# 공급자를 하나도 등록하지 않았을 때만 마지막 수단으로 쓰입니다.
SIGNALIST_LLM_API_KEY=
SIGNALIST_LLM_BASE_URL=
SIGNALIST_LLM_MODEL=
SIGNALIST_LLM_TIMEOUT_MS=25000

# 리서치 데이터 공급자
SIGNALIST_DART_API_KEY=
SIGNALIST_SEC_USER_AGENT=Name email@example.com

# 선택. 설정하면 리서치 인덱스 캐시를 워커 간에 공유한다(redis 패키지 필요).
SIGNALIST_CACHE_URL=

# 한국투자증권 Open API. 종목 검색(종목마스터)은 자격증명 없이 동작하고,
# 시세·수급 조회에만 필요합니다. 모의투자 계좌면 SIGNALIST_KIS_PAPER=1 로 두세요.
SIGNALIST_KIS_APP_KEY=
SIGNALIST_KIS_APP_SECRET=
SIGNALIST_KIS_PAPER=0
