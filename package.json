{
  "name": "signalist",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "scheduler": "node --env-file-if-exists=.env scripts/scheduler.mjs",
    "scheduler:once": "node --env-file-if-exists=.env scripts/scheduler.mjs --once",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "npm run build && node --test tests/news-crawler.test.mjs tests/news-insights.test.mjs tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/news-crawler.test.mjs tests/news-insights.test.mjs",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
